{
  "name": "@gzqdev/dsh-memory-starmap",
  "version": "0.2.1",
  "type": "module",
  "description": "把 dsh-memento 的条目画成一张只读星图（宿主侧只读路由 + 浏览器全屏浮层），零第三方依赖。",
  "main": "./index.mjs",
  "exports": {
    ".": {
      "default": "./index.mjs"
    },
    "./client": {
      "default": "./client/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "client",
    "ui",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "starmap",
    "graph"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    },
    "capabilities": [
      "filesystem:read"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoayuqi/dsh-memory-starmap.git"
  },
  "homepage": "https://github.com/hoayuqi/dsh-memory-starmap#readme",
  "bugs": {
    "url": "https://github.com/hoayuqi/dsh-memory-starmap/issues"
  },
  "scripts": {
    "test": "node tools/selftest.mjs && node tools/clienttest.mjs",
    "pack": "npm pack"
  },
  "publishConfig": {
    "access": "public"
  }
}
